# ==============================================================================
# 🔥 Burner — Environment Configuration (100% OPTIONAL FOR JUDGING)
# ==============================================================================
#
# NOTE FOR JUDGES & EVALUATORS:
# You DO NOT need any API keys or paid accounts to test or run Burner!
# Burner runs out-of-the-box using an intelligent, deterministic local heuristic
# strategist, local file signal adapters, and an interactive Demo Simulation Drawer.
#
# If you would like to test cloud LLM-augmented reasoning, copy this file to .env:
#   cp .env.example .env
# And provide any of the free-tier keys below:
# ==============================================================================

# 1. Google Gemini API Key (Optional)
# Used for deep task routing reasoning, prompt optimization, and quota copilot chat.
# Obtain a free key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# 2. Groq Cloud API Key (Optional)
# Used for ultra-fast LPU sub-second inference fallbacks.
# Obtain a free key from Groq Console: https://console.groq.com
GROQ_API_KEY=

# 3. NVIDIA NIM API Key (Optional)
# Used as a cloud inference microservice fallback for open-weight models (e.g. Llama 3).
# Obtain from NVIDIA NGC: https://build.nvidia.com
NVIDIA_API_KEY=
